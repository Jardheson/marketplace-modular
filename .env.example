# Ambiente
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=supersecret-key-change-in-production
JWT_EXPIRES_IN=7d

# Cache
CACHE_TTL_SECONDS=300

# Observabilidade
OTEL_ENABLED=false
OTEL_SERVICE_NAME=marketplace-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Feature Flags
FF_NEW_CHECKOUT=false

# Logs
LOG_LEVEL=info
